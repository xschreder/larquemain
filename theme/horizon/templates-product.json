                        "padding-block-end": 16,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_marque_5"
                  ]
                }
              },
              "block_order": [
                "row_marque_1",
                "row_marque_2",
